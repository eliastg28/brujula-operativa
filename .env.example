# ─────────────────────────────────────────────────────────────
#  Brújula Operativa — configuración
#  Copia este archivo a .env y completa lo que tengas.
#  Sin nada configurado, la app corre 100% en Modo Demo.
# ─────────────────────────────────────────────────────────────

# demo = Jira/Teams simulados dentro de la web | live = usa credenciales reales
MODE=demo

# ── IA (Claude) ──────────────────────────────────────────────
# Si no hay key, los agentes usan el motor offline de respaldo (la demo nunca falla).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high  (low = respuestas más rápidas para la demo en vivo)
AI_EFFORT=low
# auto = usa Claude si hay key | off = fuerza motor offline
AI_MODE=auto
# Segundos máximos por agente antes de caer al respaldo offline
AI_TIMEOUT=60

# ── MCP Server ───────────────────────────────────────────────
MCP_PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp

# ── Jira Cloud (MODE=live) ───────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Proyecto de Jira donde se crean épicas e historias (en live lo comparten todos los squads)
JIRA_PROJECT_KEY=

# ── Microsoft Teams (Workflows webhook — "When a Teams webhook request is received") ──
TEAMS_WEBHOOK_URL=

# ── Correo (opcional, SMTP) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# URL pública de la web (para los botones de las tarjetas de Teams)
APP_PUBLIC_URL=http://localhost:5173
